[paths]
profile = "data/profile.yaml"
generated_profile = "data/profile.generated.yaml"
output = "output"
templates = "templates"
database = "data/jobbot.sqlite"
# Optional: default legacy moderncv for `jobbot profile import-latex`
# Prefer a path outside the repo for the real CV, or a local ignored copy:
# legacy_cv = "/absolute/path/to/your/cv.tex"
# legacy_cv = "latex/cv.tex"   # after: cp latex/cv.tex.demo latex/cv.tex
# Demo (safe, tracked): uv run jobbot profile import-latex latex/cv.tex.demo

[browser.indeed]
profile_dir = "browser-data/indeed"
headless = false
slow_mo = 100

[browser.linkedin]
profile_dir = "browser-data/linkedin"
headless = false
slow_mo = 100

[search]
# Where you want to work. Posts detected in other countries are skipped by the
# sweep; override per run with --country PE (repeatable) or --any-country.
countries = ["CL"]
# Remote rescues a foreign posting only when it is not tied to a place:
# "100% remoto para LATAM" survives, "remoto con visitas a Monterrey" does not.
allow_remote = true
# Skip postings older than this (0 = keep every age). Override: --max-age-days N / --any-age
max_age_days = 30

[indeed]
country = "cl"

[linkedin]
read_only = true

[sync]
# Writes to external portals are dry-run unless --apply is passed.
require_apply = true
removal_policy = "ignore"
